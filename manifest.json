{
  "manifest_version": 3,
  "name": "Smart Focus Shield",
  "version": "1.0",
  "description": "Blocks distracting videos with focus shield logic",
  "permissions": ["tabs", "scripting", "activeTab", "storage"],
  "host_permissions": ["http://127.0.0.1:5050/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_title": "Smart Focus"
  }
}